{
	"name": "nextcloud/nccare",
	"description": "The NC Care Nextcloud App is designed to collect non-sensitive system information from a Nextcloud installation and transmit it to the NC Care Admin backend.",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "ITServicenet",
			"email": "nccare@itservicenet.net",
			"homepage": "https://itservicenet.net"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\NCCare\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"bamarni/composer-bin-plugin": "^1.8",
		"php": ">=8.3 <8.6"
	},
	"require-dev": {
		"doctrine/dbal": "^3.7",
		"nextcloud/ocp": "dev-stable30",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	}
}
